# Copy to .env (never commit .env). Existing environment variables take precedence.

# FinMind API token from https://finmindtrade.com (member page). Optional: without it the limit is 300 req/hour.
# In the Claude cloud session the network proxy injects the real token; use the placeholder below there.
FINMIND_TOKEN=proxy-injected

# Optional path overrides
# TQS_DATA_DIR=./data
# TQS_DB_PATH=./data/database/taiwan_stocks.sqlite
